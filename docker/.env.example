# ==============================================================================
# Переменные окружения для развертывания TrickSurf через Docker
# Скопируйте этот файл в .env и настройте нужные значения:
# cp .env.example .env
# ==============================================================================

# --- База данных MySQL ---
MYSQL_USER=surfgxds
MYSQL_PASSWORD=surfgxds
MYSQL_DATABASE=surfgxds_dev
MYSQL_ROOT_PASSWORD=surfgxds_root_pwd

# Строка подключения Prisma (внутри docker-сети имя хоста `trick-surf-db`)
DATABASE_URL=mysql://surfgxds:surfgxds@trick-surf-db:3306/surfgxds_dev

# --- Серверная конфигурация (Backend) ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=http://localhost:3334
CORS_EXTRA_ORIGINS=

# --- Клиентская конфигурация (Frontend) ---
# Базовый URL API для клиента
VITE_API_URL=http://localhost:8080
VITE_CDN_URL=

# --- Мониторинг SigNoz / OpenTelemetry ---
# OTLP endpoint коллектора SigNoz (например, http://localhost:4318 или http://signoz-ingester:4318)
# Если переменная пустая, отправка телеметрии отключена
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=trick-surf-server

# --- Продакшен / Traefik / Docker Registry (Опционально) ---
REGISTRY=docker.io
V_CLIENT=latest
V_SERVER=latest
DOMAIN_CLIENT=trick-surf.limited-dissolve.ru
DOMAIN_API=trick-surf-api.limited-dissolve.ru

