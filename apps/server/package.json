{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@injurka/trick-surf-server",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "TrickSurf Backend Application",
  "author": {
    "name": "Ivan Kornilov",
    "email": "injurka@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "backend",
    "bun",
    "elysia"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "--------------------------------<      DEV       >--------------------------------": "",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "--------------------------------< LINT & FORMAT >---------------------------------": "",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --reporter verbose",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "--------------------------------<   DATABASE    >---------------------------------": "",
    "prisma:migrate": "bunx prisma migrate dev",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:push": "bunx prisma db push",
    "prisma:format": "bunx prisma format",
    "prisma:generate": "bunx prisma generate",
    "prisma:generate:watch": "bunx prisma generate --watch",
    "prisma:seed": "bun prisma/seed.ts",
    "prisma:studio": "bunx prisma studio",
    "prisma:reset": "bunx prisma migrate reset --force"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "elysia": "^1.4.29",
    "mariadb": "^3.5.3",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@types/bun": "^1.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-format": "^2.0.1",
    "jiti": "^2.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  }
}
